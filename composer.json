{
    "name": "matatirosoln/sql-to-odata",
    "description": "Convert SQL queries to OData query syntax.",
    "type": "library",
    "require": {
        "php": "^8.4",
        "phpmyadmin/sql-parser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Matatirosoln\\SqlToOdata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Matatirosoln\\SqlToOdata\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Steve Winter",
            "email": "steve@msdev.nz"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
